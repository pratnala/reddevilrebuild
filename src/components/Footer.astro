---
import Icon from './Icon.astro';

const currentYear = new Date().getFullYear();

const linkGroups = [
    [
        { label: 'YouTube Music', href: 'https://music.youtube.com/playlist?list=PLkb7UY4Zx9BGf42EJvBkr9XCd2eb5TbhU', icon: 'youtube-music', color: '#ff0033' },
        { label: 'Spotify', href: 'https://open.spotify.com/show/6KRHpQkWkhsqbOlnV7X7qT', icon: 'spotify', color: '#1db954' },
        { label: 'Apple Podcasts', href: 'https://podcasts.apple.com/us/podcast/red-devil-rebuild/id1793914048', icon: 'podcast', color: '#872ec4' },
        { label: 'Pocket Casts', href: 'https://pca.st/8dtb0xvb', icon: 'pocket-casts', color: '#f43e37' }
    ],
    [
        { label: 'YouTube', href: 'https://www.youtube.com/@RedDevilRebuild', icon: 'youtube', color: '#ff0033' },
        { label: 'Twitch', href: 'https://www.twitch.tv/reddevilrebuild', icon: 'twitch', color: '#9146ff' },
        { label: 'Instagram', href: 'https://www.instagram.com/reddevilrebuild/', icon: 'instagram', color: '#ff0069' },
        { label: 'TikTok', href: 'https://www.tiktok.com/@reddevilrebuild', icon: 'tiktok', color: 'white' }
    ],
    [
        { label: 'X (Twitter)', href: 'https://x.com/reddevilrebuild', icon: 'x-twitter', color: 'white' },
        { label: 'Threads', href: 'https://www.threads.com/@reddevilrebuild', icon: 'threads', color: 'white' },
        { label: 'Facebook', href: 'https://www.facebook.com/reddevilrebuild', icon: 'facebook', color: '#1877f2' },
        { label: 'LinkedIn', href: 'https://www.linkedin.com/company/reddevilrebuild', icon: 'linkedin', color: '#0a66c2' }
    ]
];
---
<footer class="bg-dark text-center text-white py-5 mt-5">
    <div class="container">
        <h2 class="h5 mb-4 fw-bold">Listen &amp; Follow</h2>
        <div class="d-flex flex-column flex-lg-row justify-content-center align-items-center gap-4 fs-2">
            {linkGroups.map((group, index) => (
                <>
                    {index > 0 && <span class="text-secondary fs-4 d-none d-md-inline" aria-hidden="true">|</span>}
                    <div class="d-flex gap-4">
                        {group.map(link => (
                            <a href={link.href} target="_blank" rel="noopener" aria-label={link.label}>
                                <Icon name={link.icon} style={`color: ${link.color};`} />
                            </a>
                        ))}
                    </div>
                </>
            ))}
        </div>
        <p class="mt-4 mb-0 text-secondary small">
            &copy; 2025 &mdash; {currentYear} Red Devil Rebuild. All rights reserved.
        </p>
    </div>
</footer>
