---
const { seasons } = Astro.props;
---
<ul class="nav nav-pills justify-content-center mt-4 mb-3 season-tabs-container">
    {seasons.map(season => (
        <li class="nav-item">
            <a class:list={['nav-link', { active: season === seasons[0] }]} href="#" data-target-season={season}>Season {season}-{Number(season) - 1999}</a>
        </li>
    ))}
</ul>
